# Copy to .env for local testing (.env is git-ignored — never commit real keys).
TELEGRAM_BOT_TOKEN=123456789:AAE...
# At least one AI key is required; they are tried in this order.
GEMINI_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-...
GROQ_API_KEY=gsk_...

# Whop product publishing (optional). Keep these only in your local .env or host secrets.
# The company ID begins with biz_. The API key needs product creation permission.
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_...
